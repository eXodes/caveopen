{
  "name": "caveopen",
  "version": "0.0.0",
  "description": "Caveman, Cavekit v4, and Cavemem for OpenCode",
  "type": "module",
  "main": "dist/caveopen.js",
  "types": "dist/caveopen.d.ts",
  "exports": {
    ".": {
      "import": "./dist/caveopen.js",
      "types": "./dist/caveopen.d.ts"
    }
  },
  "bin": {
    "caveopen": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-test-module-mocks --test 'dist/test/**/*.test.js'",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.16.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "cavemem": ">=1.0.0",
    "@cavemem/core": ">=0.2.0",
    "@cavemem/config": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "cavemem": {
      "optional": true
    },
    "@cavemem/core": {
      "optional": true
    },
    "@cavemem/config": {
      "optional": true
    }
  },
  "keywords": [
    "opencode",
    "plugin",
    "caveman",
    "cavekit",
    "cavemem"
  ],
  "oc-plugin": ["server"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eXodes/caveopen"
  }
}
