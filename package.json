{
  "name": "caveopen",
  "version": "0.0.0",
  "description": "Caveman, Cavekit v4, and Cavemem for OpenCode",
  "type": "module",
  "main": "dist/caveopen.js",
  "types": "dist/caveopen.d.ts",
  "exports": {
    ".": {
      "import": "./dist/caveopen.js",
      "types": "./dist/caveopen.d.ts"
    },
    "./caveman": {
      "import": "./dist/modules/caveman/index.js",
      "types": "./dist/modules/caveman/index.d.ts"
    },
    "./cavekit": {
      "import": "./dist/modules/cavekit/index.js",
      "types": "./dist/modules/cavekit/index.d.ts"
    },
    "./cavemem": {
      "import": "./dist/modules/cavemem/index.js",
      "types": "./dist/modules/cavemem/index.d.ts"
    }
  },
  "bin": {
    "caveopen": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc && copyfiles -u 1 \"src/**/*.md\" dist",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.16.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "copyfiles": "^2.4.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "cavemem": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "cavemem": {
      "optional": true
    }
  },
  "keywords": [
    "opencode",
    "plugin",
    "caveman",
    "cavekit",
    "cavemem"
  ],
  "oc-plugin": [
    "server"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eXodes/caveopen.git"
  }
}
