{
  "name": "caveopen",
  "version": "0.1.0",
  "description": "Caveman, cavekit v4, and cavemem for OpenCode",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "assets",
    "install.sh"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.16.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "cavemem": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "cavemem": {
      "optional": true
    }
  },
  "keywords": [
    "opencode",
    "plugin",
    "caveman",
    "cavekit",
    "cavemem"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/exodes/caveopen"
  }
}
